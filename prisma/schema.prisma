generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AuthSession {
  id                     String    @id @default(uuid())
  sessionIdHash          String    @unique @map("session_id_hash")
  userId                 String    @map("user_id")
  email                  String?
  encryptedAccessToken   String    @map("encrypted_access_token")
  encryptedRefreshToken  String    @map("encrypted_refresh_token")
  encryptedCsrfToken     String    @map("encrypted_csrf_token")
  accessTokenExpiresAt   DateTime  @map("access_token_expires_at")
  expiresAt              DateTime  @map("expires_at")
  lastActivityAt         DateTime  @map("last_activity_at")
  revokedAt              DateTime? @map("revoked_at")
  csrfTokenHash          String    @map("csrf_token_hash")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("auth_session")
}

model AuthChallenge {
  id               String    @id @default(uuid())
  challengeIdHash  String    @unique @map("challenge_id_hash")
  userId           String?   @map("user_id")
  challengeName    String    @map("challenge_name")
  encryptedSession String    @map("encrypted_session")
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("auth_challenge")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED

  @@map("invitation_status")
}

model UserProfile {
  id          String   @id @default(uuid())
  cognitoSub  String   @unique @map("cognito_sub")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phoneNumber String   @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user_profile")
}

model UserInvitation {
  id          String           @id @default(uuid())
  email       String
  cognitoSub  String?          @map("cognito_sub")
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([email])
  @@index([cognitoSub])
  @@map("user_invitation")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorSub  String   @map("actor_sub")
  action    String
  targetSub String?  @map("target_sub")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([targetSub, createdAt])
  @@map("audit_log")
}
