# EnerCol — Variables de entorno
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:root@localhost:5432/enercol

# AWS Connection
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# AWS Cognito
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_6rwk6IAdH
COGNITO_CLIENT_ID=your_cognito_app_client_id
COGNITO_CLIENT_SECRET=your_cognito_app_client_secret

# Cognito token verification
COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_6rwk6IAdH
COGNITO_JWKS_URI=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_6rwk6IAdH/.well-known/jwks.json

# Session
SESSION_ENCRYPTION_KEY=your_base64_encoded_32_byte_key
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=1800

# Cookies
COOKIE_NAME=enercol_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Semilla de los dos casos técnicos. No la usa el arranque de NestJS.
# Copie el sub de Cognito del especialista (userId de GET /api/v1/identity/me). No invente un valor.
SEED_SPECIALIST_SUB=

# Bóveda de tokens de privacidad. MongoDB solo guarda mapeos cifrados.
# PRIVACY_ENCRYPTION_KEY debe ser una clave de 32 bytes codificada en Base64.
# Genérela en local con: openssl rand -base64 32
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=enercol_privacy
PRIVACY_ENCRYPTION_KEY=your_base64_encoded_32_byte_key

# OpenAI queda solo en el backend. Sin clave, la API arranca y la generación del informe falla.
# El modelo, el esfuerzo de razonamiento y el tope de tokens de salida se cambian aquí, sin modificar código.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=6000